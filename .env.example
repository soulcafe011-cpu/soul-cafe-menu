# Supabase project settings (create these in the owner's Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Cafe WhatsApp number, international format with digits only, no +, spaces, or dashes.
# Example format: 9639XXXXXXXX
NEXT_PUBLIC_CAFE_WHATSAPP=963XXXXXXXXX

# Currency label displayed in the menu (example: ل.س, TRY, USD)
NEXT_PUBLIC_CURRENCY=ل.س
